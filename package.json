{
  "name": "habra-github-pages",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "dev": "vite",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "test:browser": "node tests/browser-check.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "check:worker": "tsc -p worker/tsconfig.json",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:seed:local": "node --experimental-strip-types scripts/seed-database.ts --local",
    "dev:cloudflare": "wrangler dev --ip 127.0.0.1 --port 8787 --var APP_URL:http://127.0.0.1:8787",
    "test:cloudflare": "node tests/cloudflare-check.mjs",
    "deploy:cloudflare": "node scripts/deploy-cloudflare.mjs"
  },
  "dependencies": {
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "^1.31.0",
    "radix-ui": "^1.6.7",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tailwind-merge": "3.6.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261005.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "playwright-core": "1.63.0",
    "tailwindcss": "4.2.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vite": "8.0.13",
    "wrangler": "4.147.0"
  }
}
